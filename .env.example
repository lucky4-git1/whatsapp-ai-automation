# ==============================================================================
# WhatsApp AI Automation SaaS - Production Environment Template
# Copy this file to .env and supply actual production secrets
# ==============================================================================

# Database (Neon PostgreSQL)
# Pooled connection string for regular queries (PgBouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations & schema push
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Queue & Cache (Upstash / Northflank Managed Redis)
REDIS_URL="rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379"

# Server Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN="https://your-frontend.vercel.app,http://localhost:3000"

# Application Security Keys (Generate strong 32+ char random strings)
JWT_SECRET=generate-secure-jwt-secret-min-32-chars-random-key
SESSION_SECRET=generate-secure-session-secret-min-32-chars-random-key
# 32-byte hex or 32-character key for encrypting WhatsApp API tokens at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# WhatsApp Cloud API (Meta Developer App)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_SECRET=your-secret-webhook-verify-token

# Queue & Concurrency Limits
WORKER_CONCURRENCY=5
WEBHOOK_CONCURRENCY=5
MESSAGE_CONCURRENCY=3
AI_CONCURRENCY=2
CAMPAIGN_CONCURRENCY=1

# AI Provider Configuration (Optional)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
OPENAI_API_KEY=sk-your-openai-api-key

# Frontend Client Environment (Used during Vercel Build)
VITE_API_URL=https://your-backend-api.northflank.app
VITE_APP_NAME="WhatsApp AI Automation"
