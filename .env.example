# Database
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_automation
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
PORT=3000
API_PORT=4000
WORKER_CONCURRENCY=5
WEBHOOK_CONCURRENCY=5
MESSAGE_CONCURRENCY=3
AI_CONCURRENCY=2
CAMPAIGN_CONCURRENCY=1

# Authentication
JWT_SECRET=your-jwt-secret-here-min-32-chars
SESSION_SECRET=your-session-secret-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-here-32-bytes

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v18.0
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-here

# AI Provider (OpenAI/Anthropic/etc)
AI_PROVIDER=openai
AI_MODEL=gpt-4-turbo-preview
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Knowledge Base (Pinecone)
ENABLE_KNOWLEDGE_BASE=false
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=whatsapp-ai-knowledge
KNOWLEDGE_SIMILARITY_THRESHOLD=0.7
KNOWLEDGE_MAX_RESULTS=5
CONVERSATION_HISTORY_LIMIT=10
ENABLE_AUTO_DETECT_LANGUAGE=true

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# Monitoring
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=WhatsApp AI Automation
